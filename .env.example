# ==========================================================
# Orthopedic AI Voice Agent: environment template
# Copy to .env and fill in the values. Never commit .env.
#
# Rules (important for Docker's --env-file on the VM):
#   - Put comments on their OWN line. A "# note" after a value
#     becomes part of the value and breaks it.
#   - Each variable must appear once.
#   - No quotes and no spaces around "=".
# The full list with defaults is in app/config.py.
# ==========================================================

APP_ENV=production

# ── Database (PostgreSQL) ──────────────────────────────────
# On the VM: the RDS endpoint directly (no tunnel).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS-ENDPOINT:5432/DATABASE_NAME?sslmode=require
# On your laptop through the SSH tunnel (same local port as in the tunnel command; use 127.0.0.1, not localhost):
#   ssh -N -L 5435:RDS-ENDPOINT:5432 prime-prod
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5435/DATABASE_NAME?sslmode=require
# Local Docker Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/orthopedic_voice

# ── Public URL ─────────────────────────────────────────────
# HTTPS address Plivo can reach. No trailing slash.
# Locally: your ngrok address (it changes every time ngrok restarts).
PUBLIC_BASE_URL=https://your-domain.example.com

# ── Telephony: Plivo ───────────────────────────────────────
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=+91XXXXXXXXXX
# Turn on only after the first successful real call.
PLIVO_VALIDATE_SIGNATURE=false
PLIVO_SPEAK_VOICE=
PLIVO_SPEAK_LANGUAGE=

# ── Speech providers ───────────────────────────────────────
# sarvam or bodhan
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
TTS_CONCURRENCY=3
# Folder for saved speech audio. Empty = .cache/tts (mount /app/.cache as a volume in Docker).
TTS_CACHE_DIR=

# ── Sarvam ─────────────────────────────────────────────────
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_STT_LANGUAGE=unknown
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6

# ── LLM: OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
REPLY_MAX_TOKENS=220

# ── Clinic ─────────────────────────────────────────────────
DEFAULT_LANGUAGE=or
DOCTOR_NAME=Dr. Full Name
# Emergency calls are transferred here (doctor). E.164 format.
ESCALATION_PHONE=+91XXXXXXXXXX
# "Connect me to the receptionist" rings this number.
RECEPTIONIST_PHONE=+91XXXXXXXXXX
# Optional second number if the first does not answer.
BACKUP_PHONE=
TRANSFER_RING_SECONDS=25
# An assistant leg shorter than this many seconds is not a real answer, so the bot resumes.
RECEPTIONIST_MIN_TALK_S=5
INBOUND_RECORDING=true

# ── Admin API and staff dashboard ──────────────────────────
# Protects /appointments and /staff and the dashboard sign-in.
# Empty = switched off (503). Use a long random value, for example:
#   python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_API_KEY=

# ── Outbound reminder calls ────────────────────────────────
# Master switch. Keep false until a test call works, and keep it true on only ONE deployment per database.
OUTBOUND_ENABLED=false
OUTBOUND_RECORDING=false
# Calling window, India time.
OUTBOUND_START_HOUR=10
OUTBOUND_END_HOUR=19
OUTBOUND_MAX_PER_RUN=5
OUTBOUND_MAX_CONCURRENT=2
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_MINUTES=30
# How often the scheduler checks, and when it calls.
REMINDER_POLL_MINUTES=5
REMINDER_HOURS_BEFORE=24
REMINDER_MIN_LEAD_HOURS=2

# ── Voice pipeline ─────────────────────────────────────────
VAD_RMS_THRESHOLD=450
VAD_END_SILENCE_MS=600
VAD_MIN_SPEECH_MS=300
VAD_MAX_UTTERANCE_S=25
BARGE_IN_MS=400
# true writes what callers say into the logs. Testing only; use false in production.
LOG_TRANSCRIPTS=false

# ── Latency (short "one moment" filler while a slow reply is prepared) ──
FILLER_ENABLED=true
FILLER_AFTER_MS=1500
FILLER_MIN_SPEECH_S=2.5
FILLER_MAX_PER_CALL=2

# ── Inbound call timing ────────────────────────────────────
# Silence after a booking question before the bot asks once more (seconds).
INBOUND_SILENCE_REASK_S=7.0

# ── Optional, unused providers ─────────────────────────────
# Leave blank unless you switch to them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_VOICE=Polly.Aditi
SPEECH_LANGUAGE=en-IN

BODHAN_API_BASE_URL=https://api.bodhan.ai/v1
BODHAN_TRANSCRIBE_API_KEY=
BODHAN_SPEAK_API_KEY=
BODHAN_VOICE=Kavya
BODHAN_TTS_STYLE=
BODHAN_STT_LANGUAGE=
